# Copy to .env.local and fill in your values:
# cp .env.example .env.local

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/insidcode

# NextAuth providers (Google / GitHub OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Code execution (OnlineCompiler API)
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key
MAX_CONCURRENT_EXECUTIONS=4
MAX_QUEUE_CAPACITY=100

# Email (Resend) for feedback notifications
RESEND_API_KEY=your_resend_api_key
FEEDBACK_TO_EMAIL=you@example.com
ADMIN_EMAIL=you@example.com

# Optional: Google site verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
